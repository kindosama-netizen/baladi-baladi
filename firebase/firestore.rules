rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu_items/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /advertisements/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}