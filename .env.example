# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave empty for local SQLite; use Render DATABASE_URL in production
DATABASE_URL=

# Public site URL used inside QR codes (must be production URL in prod)
PUBLIC_SITE_URL=http://localhost:5173

# Cloudinary (required for persistent uploads on Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=False

# CORS (comma-separated; not needed when SPA is served from same origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
